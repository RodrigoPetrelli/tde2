{
  "name": "pedeja-backend",
  "version": "1.0.0",
  "description": "Backend inicial do PedeJá - plataforma de pedidos de delivery de restaurante",
  "private": true,
  "main": "dist/main/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/server.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:arch": "jest --selectProjects architecture"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/tests/unit"
        ]
      },
      {
        "displayName": "integration",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/tests/integration"
        ]
      },
      {
        "displayName": "architecture",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/tests/architecture"
        ]
      }
    ]
  }
}
